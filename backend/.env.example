MONGODB_URI=
PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_SECONDS=3600
SEED_ADMIN_PASSWORD=Admin123!
# SMTP es opcional en desarrollo: sin SMTP_HOST los mails (recuperacion de
# contraseña, invitaciones y avisos de consultas) se escriben en la consola del
# servidor. Con NODE_ENV=production es obligatorio.
# Cantidad de proxies delante de la API; vacio si no hay ninguno.
TRUST_PROXY=
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TechStore <no-reply@techstore.com>
