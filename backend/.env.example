# Base de datos (obligatoria)
MONGODB_URI=

# Servidor
PORT=8080
# URL publica de la API: se usa para armar las URLs de las imagenes.
BACKEND_URL=http://localhost:8080
# URL del frontend: es el unico origen que CORS autoriza y se usa en los enlaces
# de los mails.
FRONTEND_URL=http://localhost:5173
# Cantidad de proxies delante de la API; vacio si no hay ninguno.
TRUST_PROXY=

# Autenticacion
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_SECONDS=3600
# Contraseña del administrador que crea `npm run seed`.
SEED_ADMIN_PASSWORD=Admin123!

# SMTP es opcional en desarrollo: sin SMTP_HOST los mails (recuperacion de
# contraseña, invitaciones y avisos de consultas) se escriben en la consola del
# servidor. Con NODE_ENV=production es obligatorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=KernelStore <no-reply@kernelstore.com>
